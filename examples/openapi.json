            "title": "Next Offset"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/FeatureMeasurement"
            },
            "type": "array",
            "title": "Features"
          }
        },
        "type": "object",
        "required": [
          "file_id",
          "count",
          "next_offset",
          "features"
