                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Id"
          },
          "geometry_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Geometry Type"
          },
          "geometry": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Geometry"
          },
          "source_geometry_xml": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Geometry Xml"
          },
          "properties": {
            "additionalProperties": true,
            "type": "object",
            "title": "Properties"
          },
          "source_crs": {
            "type": "string",
            "title": "Source Crs"
          },
          "measurement_status": {
            "type": "string",
            "title": "Measurement Status"
          },
          "measurement_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "area",
                  "length"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Measurement Type"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "m",
                  "m2"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "measurement_crs": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Measurement Crs"
          },
          "warning_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warning Code"
          }
        },
        "type": "object",
        "required": [
          "index",
          "source_id",
          "geometry_type",
          "geometry",
          "properties",
          "source_crs",
          "measurement_status",
          "measurement_type",
          "value",
          "unit",
          "measurement_crs",
          "warning_code"
        ],
        "title": "FeatureMeasurement"
      },
      "FileInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "feature_count": {
            "type": "integer",
            "title": "Feature Count"
          },
          "crs": {
            "type": "string",
            "title": "Crs"
          },
          "status": {
            "type": "string",
